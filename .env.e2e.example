# Playwright end-to-end suite — copy to .env.e2e (git-ignored) and fill in.
# Both accounts are LONG-LIVED: create them once, keep them, never delete them.
# The staff account needs its role granted once by SQL — see tests/e2e/README.md.

E2E_STAFF_EMAIL=e2e-staff@example.com
E2E_STAFF_PASSWORD=change-me-long-and-random
E2E_LEARNER_EMAIL=e2e-learner@example.com
E2E_LEARNER_PASSWORD=change-me-long-and-random

# Target under test. Leave unset to have Playwright start `npm run dev` on :8080.
# E2E_BASE_URL=http://localhost:8080
